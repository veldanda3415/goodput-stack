    {
      "id": 19,
      "type": "timeseries",
      "title": "Gateway pre-upstream processing (includes the EPP ext-proc call)",
      "description": "The EPP exports no decision latency, so this is the proxy. Evidence (observability/alert_test.py, 2026-10-14, sim-pool): mean 1.354 ms with the EPP up (n=55) vs 0.21 ms with it scaled to 0 (FailOpen, n=103), so ~1.1 ms of this is the ext-proc round trip. The histogram's lowest bucket is 1 ms, so the p95 is coarse; the mean (sum/count, not an average of percentiles) is the better read.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pool) (rate(agentgateway_request_processing_seconds_sum{namespace=\"inference\"}[1m])) / sum by (pool) (rate(agentgateway_request_processing_seconds_count{namespace=\"inference\"}[1m]))",
          "legendFormat": "mean {{pool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, pool) (rate(agentgateway_request_processing_seconds_bucket{namespace=\"inference\"}[1m])))",
          "legendFormat": "p95 {{pool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
