      "targets": [
        {
          "refId": "A",
          "expr": "max by (pool, pod) (vllm:kv_cache_usage_perc{namespace=\"inference\"})",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
