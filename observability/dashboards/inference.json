    {
      "id": 21,
      "type": "timeseries",
      "title": "sim-pool: replicas vs queue vs latency",
      "description": "The KEDA trigger metric (autoscaling/scaledobject-*.yaml) against replica count and latency. Client TTFT per step is in autoscaling/results/ (loadgen.py). SIMULATED: llm-d-inference-sim v0.10.2, latencies are configured, not measured on a model.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 59,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*\\(s\\).*"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_spec_replicas{namespace=\"inference\",deployment=\"inf-vllm-sim\"}",
          "legendFormat": "desired replicas",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "kube_deployment_status_replicas_available{namespace=\"inference\",deployment=\"inf-vllm-sim\"}",
          "legendFormat": "available replicas",
