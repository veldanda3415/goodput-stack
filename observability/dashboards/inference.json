    {
      "id": 17,
      "type": "timeseries",
      "title": "EPP health",
      "description": "EPP scrape up, available replicas, and how many pool endpoints the EPP considers ready. llm-d-router-gateway v0.9.0 exports no scheduling-decision latency and no request counter (live /metrics, 2026-10-14). When the EPP has 0 replicas the gateway FAILS OPEN (GAPS.md P2): requests still succeed, load-blind; see alert EPPUnavailableFailOpen.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 43,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{namespace=\"inference\",job=~\".+-pool-epp\"}",
          "legendFormat": "scrape up {{pool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "kube_deployment_status_replicas_available{namespace=\"inference\",deployment=~\".+-pool-epp\"}",
          "legendFormat": "available {{deployment}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "llm_d_epp_ready_endpoints{namespace=\"inference\"}",
          "legendFormat": "ready endpoints seen by EPP {{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Replicas per deployment",
