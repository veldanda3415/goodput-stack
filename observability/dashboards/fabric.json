{
  "uid": "goodput-fabric",
  "title": "goodput-stack / EMULATED fabric",
  "tags": ["goodput-stack", "fabric", "emulated"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "EMULATED containerlab Linux/veth counters from the local Python exporter; byte rates are not link utilization at a hardware line rate.",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "EMULATED uplink traffic",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Leaf uplink TX bytes/s",
      "description": "Linux interface counters on EMULATED veth links. Bytes/s is a traffic-rate proxy, not hardware link utilization.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 1, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "targets": [{
        "refId": "A",
        "expr": "rate(fabric_interface_tx_bytes_total{node=~\"leaf[1-4]\"}[1m])",
        "legendFormat": "{{node}} {{interface}}",
        "datasource": {"type": "prometheus", "uid": "prometheus"}
      }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Leaf uplink max/mean imbalance",
      "description": "Per-leaf maximum uplink TX byte rate divided by the mean across both ECMP members. EMULATED Linux counters.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 1, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [{
        "refId": "A",
        "expr": "max by (node) (rate(fabric_interface_tx_bytes_total{node=~\"leaf[1-4]\"}[1m])) / avg by (node) (rate(fabric_interface_tx_bytes_total{node=~\"leaf[1-4]\"}[1m]))",
        "legendFormat": "{{node}}",
        "datasource": {"type": "prometheus", "uid": "prometheus"}
      }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Leaf uplink discards/s",
      "description": "Linux interface TX/RX dropped counters on EMULATED veth links.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 9, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "targets": [{
        "refId": "A",
        "expr": "rate(fabric_interface_tx_dropped_total{node=~\"leaf[1-4]\"}[1m]) + rate(fabric_interface_rx_dropped_total{node=~\"leaf[1-4]\"}[1m])",
        "legendFormat": "{{node}} {{interface}}",
        "datasource": {"type": "prometheus", "uid": "prometheus"}
      }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "ECN-marked packets/s",
      "description": "Linux qdisc ECN mark counters where present. No PFC/DCQCN or switch ASIC counters are exported.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 9, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "targets": [{
        "refId": "A",
        "expr": "rate(fabric_qdisc_ecn_marked_packets_total[1m])",
        "legendFormat": "{{node}} {{interface}}",
        "datasource": {"type": "prometheus", "uid": "prometheus"}
      }]
    },
    {
      "id": 6,
      "type": "row",
      "title": "EMULATED control-plane state",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 17, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "BGP neighbor established",
      "description": "FRR JSON state sampled by the host-side Python exporter. 1=Established, 0=other state.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 18, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 1}, "overrides": []},
      "targets": [{
        "refId": "A",
        "expr": "fabric_bgp_neighbor_established",
        "legendFormat": "{{node}} {{neighbor}}",
        "datasource": {"type": "prometheus", "uid": "prometheus"}
      }]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "BFD peer up",
      "description": "FRR BFD JSON state sampled by the host-side Python exporter. 1=Up, 0=other state.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 18, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 1}, "overrides": []},
      "targets": [{
        "refId": "A",
        "expr": "fabric_bfd_peer_up",
        "legendFormat": "{{node}} {{peer}}",
        "datasource": {"type": "prometheus", "uid": "prometheus"}
      }]
    },
    {
      "id": 9,
      "type": "row",
      "title": "EMULATED silent degradation signals",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 26, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Root qdisc drops per MB sent",
      "description": "Root qdisc (TBF/netem/RED) drops divided by MB transmitted on each leaf uplink. A lossy link shows a ratio far above its ECMP sibling. EMULATED Linux qdisc counters.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 27, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [{
        "refId": "A",
        "expr": "rate(fabric_qdisc_drops_total{node=~\"leaf[1-4]\"}[1m]) / (rate(fabric_interface_tx_bytes_total{node=~\"leaf[1-4]\"}[1m]) / 1e6)",
        "legendFormat": "{{node}} {{interface}}",
        "datasource": {"type": "prometheus", "uid": "prometheus"}
      }]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Uplink share of leaf TX",
      "description": "Each uplink's fraction of its leaf's uplink TX bytes. Under a many-flow L4 hash both members sit near 0.5; a degraded member loses share without any link or BGP event. EMULATED.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 8, "y": 27, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "targets": [{
        "refId": "A",
        "expr": "rate(fabric_interface_tx_bytes_total{node=~\"leaf[1-4]\"}[1m]) / on (node) group_left sum by (node) (rate(fabric_interface_tx_bytes_total{node=~\"leaf[1-4]\"}[1m]))",
        "legendFormat": "{{node}} {{interface}}",
        "datasource": {"type": "prometheus", "uid": "prometheus"}
      }]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Host TCP retransmit ratio",
      "description": "Retransmitted / sent TCP segments per host network namespace (nstat). EMULATED hosts.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 16, "y": 27, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "targets": [{
        "refId": "A",
        "expr": "rate(fabric_host_tcp_retrans_segments_total[1m]) / rate(fabric_host_tcp_out_segments_total[1m])",
        "legendFormat": "{{host}}",
        "datasource": {"type": "prometheus", "uid": "prometheus"}
      }]
    }
  ]
}
