frr defaults traditional
hostname {{ node.name }}
log stdout
service integrated-vtysh-config
!
ip forwarding
ipv6 forwarding
!
{% if node.role == "leaf" and not intent.get("zebra", {}).get("leaf_kernel_nexthop_groups", true) -%}
no zebra nexthop kernel enable
!
{% endif -%}
interface lo
 ip address {{ node.loopback }}
!
{% for interface, address in host_addresses.items() %}
interface {{ interface }}
 ip address {{ address }}
!
{% endfor %}
{% if intent.bfd.enabled %}
bfd
 profile FABRIC
  transmit-interval {{ intent.bfd.transmit_ms }}
  receive-interval {{ intent.bfd.receive_ms }}
  detect-multiplier {{ intent.bfd.detect_multiplier }}
!
{% endif %}
{%- for vrf in vrfs %}
vrf {{ vrf.name }}
 vni {{ vrf.l3vni }}
exit-vrf
!
{%- endfor %}
route-map FABRIC-IN permit 10
!
route-map FABRIC-OUT permit 10
!
{%- for vrf in vrfs %}
router bgp {{ node.asn }} vrf {{ vrf.name }}
 bgp router-id {{ node.loopback.split('/')[0] }}
 address-family ipv4 unicast
  redistribute connected
 exit-address-family
 address-family l2vpn evpn
  advertise ipv4 unicast
  route-target import {{ vrf.route_target }}
  route-target export {{ vrf.route_target }}
 exit-address-family
!
{%- endfor %}
router bgp {{ node.asn }}
 bgp router-id {{ node.loopback.split('/')[0] }}
 no bgp default ipv4-unicast
 bgp log-neighbor-changes
{% for group in peer_groups %}
 neighbor {{ group.name }} peer-group
 neighbor {{ group.name }} remote-as {{ group.asn }}
 neighbor {{ group.name }} timers {{ intent.bgp.keepalive_seconds }} {{ intent.bgp.hold_seconds }}
 neighbor {{ group.name }} route-map FABRIC-IN in
 neighbor {{ group.name }} route-map FABRIC-OUT out
{% if intent.bgp.extended_nexthop %}
 neighbor {{ group.name }} capability extended-nexthop
{% endif %}
{% if intent.bfd.enabled %}
 neighbor {{ group.name }} bfd profile FABRIC
{% endif %}
{% for interface in group.interfaces %}
 neighbor {{ interface }} interface peer-group {{ group.name }}
{% endfor %}
{% endfor %}
 address-family ipv4 unicast
{% for prefix in advertised_prefixes %}
  network {{ prefix }}
{% endfor %}
{% for group in peer_groups %}
  neighbor {{ group.name }} activate
{% endfor %}
  maximum-paths {{ intent.ecmp_width }}
 exit-address-family
{%- if evpn %}
 address-family l2vpn evpn
{%- for group in peer_groups %}
  neighbor {{ group.name }} activate
  neighbor {{ group.name }} route-map FABRIC-IN in
  neighbor {{ group.name }} route-map FABRIC-OUT out
{%- if node.role == "spine" %}
  neighbor {{ group.name }} attribute-unchanged next-hop
{%- endif %}
{%- endfor %}
{%- if node.role == "leaf" %}
  advertise-all-vni
{%- for vrf in vrfs %}
  vni {{ vrf.segment.l2vni }}
   route-target import {{ vrf.segment.route_target }}
   route-target export {{ vrf.segment.route_target }}
  exit-vni
{%- endfor %}
{%- endif %}
 exit-address-family
{%- endif %}
!
