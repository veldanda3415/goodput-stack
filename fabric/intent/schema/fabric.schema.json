{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["name", "address_plan", "rails", "nodes", "hosts", "links", "bgp", "bfd", "ecmp_width", "images", "capture_taps", "rdma", "qos"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "address_plan": {
      "type": "object",
      "required": ["loopbacks", "hosts", "management", "excluded"],
      "properties": {
        "loopbacks": {"type": "string"},
        "hosts": {"type": "string"},
        "management": {"type": "string"},
        "excluded": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "rails": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "nodes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role", "asn", "loopback"],
        "properties": {
          "name": {"type": "string"},
          "role": {"enum": ["spine", "leaf"]},
          "asn": {"type": "integer", "minimum": 1, "maximum": 4294967295},
          "loopback": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "hosts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "nics"],
        "properties": {
          "name": {"type": "string"},
          "nics": {
            "type": "array", "minItems": 2,
            "items": {
              "type": "object",
              "required": ["rail", "leaf", "interface", "address", "gateway", "subnet"],
              "properties": {
                "rail": {"type": "string"},
                "leaf": {"type": "string"},
                "interface": {"type": "string"},
                "address": {"type": "string"},
                "gateway": {"type": "string", "format": "ipv4"},
                "subnet": {"type": "string"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind", "a", "b"],
        "properties": {
          "name": {"type": "string"},
          "kind": {"enum": ["fabric", "host"]},
          "a": {
            "type": "object",
            "required": ["node", "interface"],
            "properties": {"node": {"type": "string"}, "interface": {"type": "string"}},
            "additionalProperties": false
          },
          "b": {
            "type": "object",
            "required": ["node", "interface"],
            "properties": {"node": {"type": "string"}, "interface": {"type": "string"}},
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "bgp": {
      "type": "object",
      "required": ["spine_asn", "leaf_asn_base", "hold_seconds", "keepalive_seconds", "extended_nexthop"],
      "properties": {
        "spine_asn": {"type": "integer"},
        "leaf_asn_base": {"type": "integer"},
        "hold_seconds": {"type": "integer", "minimum": 3},
        "keepalive_seconds": {"type": "integer", "minimum": 1},
        "extended_nexthop": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "bfd": {
      "type": "object",
      "required": ["enabled", "transmit_ms", "receive_ms", "detect_multiplier"],
      "properties": {
        "enabled": {"type": "boolean"},
        "transmit_ms": {"type": "integer", "minimum": 10},
        "receive_ms": {"type": "integer", "minimum": 10},
        "detect_multiplier": {"type": "integer", "minimum": 2, "maximum": 255}
      },
      "additionalProperties": false
    },
    "ecmp_width": {"type": "integer", "minimum": 1},
    "images": {
      "type": "object",
      "required": ["frr", "host", "registry"],
      "properties": {"frr": {"type": "string"}, "host": {"type": "string"}, "registry": {"type": "string"}},
      "additionalProperties": false
    },
    "capture_taps": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "rdma": {
      "type": "object",
      "required": ["enabled", "provider"],
      "properties": {
        "enabled": {"type": "boolean"},
        "provider": {"enum": ["rxe"]}
      },
      "additionalProperties": false
    },
    "qos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "classes",
        "pfc",
        "ecn",
        "pfc_watchdog",
        "cable_length_m"
      ],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "port_speed_gbps",
            "port_mtu",
            "roce_mtu",
            "sonic_port_stride"
          ],
          "properties": {
            "port_speed_gbps": {
              "enum": [
                100,
                200,
                400,
                800
              ]
            },
            "port_mtu": {
              "type": "integer",
              "minimum": 1500,
              "maximum": 9216
            },
            "roce_mtu": {
              "enum": [
                256,
                512,
                1024,
                2048,
                4096
              ]
            },
            "sonic_port_stride": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "role",
              "dscp",
              "tc",
              "queue",
              "priority_group",
              "lossless",
              "scheduler"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "role": {
                "enum": [
                  "roce",
                  "cnp",
                  "default"
                ]
              },
              "dscp": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 63
                }
              },
              "tc": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "queue": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "priority_group": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "lossless": {
                "type": "boolean"
              },
              "pfc_priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "scheduler": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "STRICT",
                      "DWRR",
                      "WRR"
                    ]
                  },
                  "weight": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  }
                }
              }
            }
          }
        },
        "pfc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "priorities",
            "xoff_threshold_bytes",
            "xon_bytes",
            "reserved_bytes",
            "mtu_s_bytes"
          ],
          "properties": {
            "priorities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              }
            },
            "xoff_threshold_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "xon_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "reserved_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "mtu_s_bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "ecn": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tc",
            "kmin_bytes",
            "kmax_bytes",
            "pmax_percent"
          ],
          "properties": {
            "tc": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            },
            "kmin_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "kmax_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "pmax_percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "pfc_watchdog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "detection_ms",
            "restoration_ms",
            "poll_ms"
          ],
          "properties": {
            "action": {
              "enum": [
                "drop",
                "forward",
                "alert"
              ]
            },
            "detection_ms": {
              "type": "integer",
              "minimum": 100,
              "maximum": 5000
            },
            "restoration_ms": {
              "type": "integer",
              "minimum": 100,
              "maximum": 60000
            },
            "poll_ms": {
              "type": "integer",
              "minimum": 100,
              "maximum": 1000
            }
          }
        },
        "cable_length_m": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fabric",
            "host",
            "links"
          ],
          "properties": {
            "fabric": {
              "type": "integer",
              "minimum": 1
            },
            "host": {
              "type": "integer",
              "minimum": 1
            },
            "links": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
